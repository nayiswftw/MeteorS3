// ====================== src/DataStore.cpp ======================
namespace ws {

DataStore::DataStore() {
  mutex_ = xSemaphoreCreateMutex();
}

DataStore::~DataStore() {
  if (mutex_) vSemaphoreDelete(mutex_);
}

AppSnapshot DataStore::snapshot() const {
  AppSnapshot copy{};
  if (!mutex_) return copy;
  xSemaphoreTake(mutex_, portMAX_DELAY);
  copy = state_;
  xSemaphoreGive(mutex_);
  return copy;
}

void DataStore::bump_() {
  ++state_.revision;
  if (state_.revision == 0) ++state_.revision;
}

void DataStore::setWeather(const WeatherSnapshot& value) {
  if (!mutex_) return;
  xSemaphoreTake(mutex_, portMAX_DELAY);
  state_.weather = value;
  bump_();
  xSemaphoreGive(mutex_);
}

void DataStore::setAir(const AirSnapshot& value) {
  if (!mutex_) return;
  xSemaphoreTake(mutex_, portMAX_DELAY);
  state_.air = value;
  bump_();
  xSemaphoreGive(mutex_);
}

void DataStore::setSystem(const SystemSnapshot& value) {
  if (!mutex_) return;
  xSemaphoreTake(mutex_, portMAX_DELAY);
  state_.system = value;
  bump_();
  xSemaphoreGive(mutex_);
}

void DataStore::mutateSystem(void (*fn)(SystemSnapshot&)) {
  if (!mutex_ || !fn) return;
  xSemaphoreTake(mutex_, portMAX_DELAY);
  fn(state_.system);
  bump_();
  xSemaphoreGive(mutex_);
}

}  // namespace ws

// ====================== src/SettingsStore.cpp ======================
namespace ws {

Settings SettingsStore::load() {
  Settings s{};
  if (!prefs_.begin("weather-v2", true)) return s;

  const uint16_t schema = prefs_.getUShort("schema", 0);
  if (schema == s.schema) {
    s.temperatureUnit = static_cast<TemperatureUnit>(prefs_.getUChar("tempUnit", static_cast<uint8_t>(s.temperatureUnit)));
    s.windUnit = static_cast<WindUnit>(prefs_.getUChar("windUnit", static_cast<uint8_t>(s.windUnit)));
    s.pressureUnit = static_cast<PressureUnit>(prefs_.getUChar("pressUnit", static_cast<uint8_t>(s.pressureUnit)));
    s.theme = static_cast<ThemeMode>(prefs_.getUChar("theme", static_cast<uint8_t>(s.theme)));
    s.autoBrightness = prefs_.getBool("autoBright", s.autoBrightness);
    s.brightnessPct = prefs_.getUChar("bright", s.brightnessPct);
    s.carousel = prefs_.getBool("carousel", s.carousel);
    s.carouselSeconds = prefs_.getUShort("carSec", s.carouselSeconds);
    s.autoOrientation = prefs_.getBool("orient", s.autoOrientation);
    s.lastPage = static_cast<Page>(prefs_.getUChar("lastPage", static_cast<uint8_t>(s.lastPage)));
  }
  prefs_.end();

  if (static_cast<uint8_t>(s.temperatureUnit) > static_cast<uint8_t>(TemperatureUnit::Fahrenheit)) s.temperatureUnit = TemperatureUnit::Celsius;
  if (static_cast<uint8_t>(s.windUnit) > static_cast<uint8_t>(WindUnit::Ms)) s.windUnit = WindUnit::Kmh;
  if (static_cast<uint8_t>(s.pressureUnit) > static_cast<uint8_t>(PressureUnit::InHg)) s.pressureUnit = PressureUnit::Hpa;
  if (static_cast<uint8_t>(s.theme) > static_cast<uint8_t>(ThemeMode::Light)) s.theme = ThemeMode::Auto;
  if (static_cast<uint8_t>(s.lastPage) >= static_cast<uint8_t>(Page::Count)) s.lastPage = Page::Home;
  s.brightnessPct = constrain(s.brightnessPct, 5, 100);
  s.carouselSeconds = constrain(s.carouselSeconds, 8, 120);
  return s;
}

bool SettingsStore::save(const Settings& s) {
  if (!prefs_.begin("weather-v2", false)) return false;
  bool ok = true;
  ok &= prefs_.putUShort("schema", s.schema) > 0;
  ok &= prefs_.putUChar("tempUnit", static_cast<uint8_t>(s.temperatureUnit)) > 0;
  ok &= prefs_.putUChar("windUnit", static_cast<uint8_t>(s.windUnit)) > 0;
  ok &= prefs_.putUChar("pressUnit", static_cast<uint8_t>(s.pressureUnit)) > 0;
  ok &= prefs_.putUChar("theme", static_cast<uint8_t>(s.theme)) > 0;
  ok &= prefs_.putBool("autoBright", s.autoBrightness) > 0;
  ok &= prefs_.putUChar("bright", s.brightnessPct) > 0;
  ok &= prefs_.putBool("carousel", s.carousel) > 0;
  ok &= prefs_.putUShort("carSec", s.carouselSeconds) > 0;
  ok &= prefs_.putBool("orient", s.autoOrientation) > 0;
  ok &= prefs_.putUChar("lastPage", static_cast<uint8_t>(s.lastPage)) > 0;
  prefs_.end();
  return ok;
}

void SettingsStore::reset() {
  if (!prefs_.begin("weather-v2", false)) return;
  prefs_.clear();
  prefs_.end();
}

}  // namespace ws

// ====================== src/NetworkService.cpp ======================
namespace ws {

void NetworkService::begin() {
  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  WiFi.persistent(false);
  // SNTP can be configured before association; it starts synchronizing as
  // soon as the network becomes available. This avoids a fetch-vs-NTP race.
  configureTime_();
  connect_();
}

void NetworkService::connect_() {
  lastAttemptMs_ = millis();
  if (strlen(WS_WIFI_SSID) == 0) {
    Serial.println("[wifi] No credentials. Copy secrets.example.h to secrets.h.");
    return;
  }
  Serial.printf("[wifi] Connecting to %s\n", WS_WIFI_SSID);
  WiFi.begin(WS_WIFI_SSID, WS_WIFI_PASSWORD);
}

void NetworkService::configureTime_() {
  configTzTime(config::kTimezone, "pool.ntp.org", "time.nist.gov", "time.google.com");
  timeConfigured_ = true;
  Serial.printf("[time] TZ=%s; NTP configured\n", config::kTimezone);
}

void NetworkService::service() {
  const bool nowConnected = connected();
  if (nowConnected && !wasConnected_) {
    Serial.printf("[wifi] Connected: %s, RSSI %d dBm\n", WiFi.localIP().toString().c_str(), WiFi.RSSI());
  } else if (!nowConnected && wasConnected_) {
    Serial.println("[wifi] Connection lost; offline cache remains active");
  }
  wasConnected_ = nowConnected;

  if (!nowConnected && strlen(WS_WIFI_SSID) > 0 && millis() - lastAttemptMs_ >= config::kWifiRetryMs) {
    lastAttemptMs_ = millis();
    WiFi.reconnect();
  }
}

void NetworkService::forceReconnect() {
  WiFi.disconnect(false, false);
  connect_();
}

}  // namespace ws

// ====================== src/OpenMeteoClient.cpp ======================
namespace ws {

bool OpenMeteoClient::getJson_(const String& url, JsonDocument& doc, const char* tag) {
  if (WiFi.status() != WL_CONNECTED) return false;

  for (uint8_t attempt = 1; attempt <= config::kHttpRetries; ++attempt) {
    WiFiClientSecure client;
    // Public weather data; HTTPS is encrypted. For strict server identity
    // validation, replace setInsecure() with a maintained CA bundle.
    client.setInsecure();
    HTTPClient http;
    http.setConnectTimeout(config::kHttpConnectTimeoutMs);
    http.setTimeout(config::kHttpReadTimeoutMs);
    http.setUserAgent("WeatherStationV2/2.0");
    http.setReuse(false);

    if (!http.begin(client, url)) {
      Serial.printf("[%s] begin failed (%u/%u)\n", tag, attempt, config::kHttpRetries);
    } else {
      const int status = http.GET();
      if (status == HTTP_CODE_OK) {
        const DeserializationError err = deserializeJson(doc, http.getStream());
        http.end();
        if (!err) return true;
        Serial.printf("[%s] JSON: %s\n", tag, err.c_str());
      } else {
        Serial.printf("[%s] HTTP %d (%u/%u)\n", tag, status, attempt, config::kHttpRetries);
        http.end();
      }
    }
    delay(250U * attempt * attempt);
  }
  return false;
}

String OpenMeteoClient::weatherUrl_() const {
  String u = "https://api.open-meteo.com/v1/forecast?latitude=";
  u += String(config::kLatitude, 6);
  u += "&longitude=" + String(config::kLongitude, 6);
  u += "&current=temperature_2m,relative_humidity_2m,apparent_temperature,dew_point_2m,pressure_msl,wind_speed_10m,wind_direction_10m,wind_gusts_10m,precipitation,rain,weather_code,is_day";
  u += "&hourly=temperature_2m,apparent_temperature,relative_humidity_2m,dew_point_2m,pressure_msl,wind_speed_10m,wind_direction_10m,wind_gusts_10m,precipitation,rain,precipitation_probability,visibility,uv_index,weather_code";
  u += "&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum,precipitation_probability_max,sunrise,sunset,uv_index_max";
  u += "&past_hours=6&forecast_hours=48&forecast_days=7";
  u += "&temperature_unit=celsius&wind_speed_unit=kmh&precipitation_unit=mm&timezone=auto";
  return u;
}

String OpenMeteoClient::airUrl_() const {
  String u = "https://air-quality-api.open-meteo.com/v1/air-quality?latitude=";
  u += String(config::kLatitude, 6);
  u += "&longitude=" + String(config::kLongitude, 6);
  u += "&current=pm10,pm2_5,carbon_monoxide,nitrogen_dioxide,sulphur_dioxide,ozone,european_aqi,us_aqi,dust";
  u += "&timezone=auto";
  return u;
}

void OpenMeteoClient::copyHm_(char (&dst)[6], const char* iso) {
  if (!iso || strlen(iso) < 16) {
    strlcpy(dst, "--:--", sizeof(dst));
    return;
  }
  memcpy(dst, iso + 11, 5);
  dst[5] = '\0';
}

void OpenMeteoClient::copyDate_(char (&dst)[11], const char* iso) {
  if (!iso || strlen(iso) < 10) {
    strlcpy(dst, "----------", sizeof(dst));
    return;
  }
  memcpy(dst, iso, 10);
  dst[10] = '\0';
}

bool OpenMeteoClient::fetchWeather(WeatherSnapshot& out) {
  JsonDocument doc;
  if (!getJson_(weatherUrl_(), doc, "weather")) return false;

  WeatherSnapshot w{};
  JsonObject current = doc["current"];
  const char* currentTime = current["time"] | "";
  strlcpy(w.observationTime, currentTime, sizeof(w.observationTime));
  w.temperature = current["temperature_2m"] | NAN;
  w.apparent = current["apparent_temperature"] | NAN;
  w.humidity = current["relative_humidity_2m"] | NAN;
  w.dewPoint = current["dew_point_2m"] | NAN;
  w.pressure = current["pressure_msl"] | NAN;
  w.wind = current["wind_speed_10m"] | NAN;
  w.windDirection = current["wind_direction_10m"] | NAN;
  w.gust = current["wind_gusts_10m"] | NAN;
  w.precipitation = current["precipitation"] | NAN;
  w.rain = current["rain"] | NAN;
  w.weatherCode = current["weather_code"] | -1;
  w.isDay = (current["is_day"] | 1) != 0;

  JsonObject hourly = doc["hourly"];
  JsonArray times = hourly["time"];
  int nowIndex = -1;
  if (strlen(currentTime) >= 13) {
    for (size_t i = 0; i < times.size(); ++i) {
      const char* t = times[i] | "";
      if (strncmp(t, currentTime, 13) == 0) {
        nowIndex = static_cast<int>(i);
        break;
      }
    }
  }
  if (nowIndex < 0) nowIndex = std::min(6, std::max(0, static_cast<int>(times.size()) - 1));

  auto arrTemp = hourly["temperature_2m"].as<JsonArray>();
  auto arrApp = hourly["apparent_temperature"].as<JsonArray>();
  auto arrHum = hourly["relative_humidity_2m"].as<JsonArray>();
  auto arrDew = hourly["dew_point_2m"].as<JsonArray>();
  auto arrPressure = hourly["pressure_msl"].as<JsonArray>();
  auto arrWind = hourly["wind_speed_10m"].as<JsonArray>();
  auto arrDir = hourly["wind_direction_10m"].as<JsonArray>();
  auto arrGust = hourly["wind_gusts_10m"].as<JsonArray>();
  auto arrPrecip = hourly["precipitation"].as<JsonArray>();
  auto arrRain = hourly["rain"].as<JsonArray>();
  auto arrProb = hourly["precipitation_probability"].as<JsonArray>();
  auto arrVis = hourly["visibility"].as<JsonArray>();
  auto arrUv = hourly["uv_index"].as<JsonArray>();
  auto arrCode = hourly["weather_code"].as<JsonArray>();

  if (nowIndex >= 0 && nowIndex < static_cast<int>(times.size())) {
    w.uv = arrUv[nowIndex] | NAN;
    w.visibility = arrVis[nowIndex] | NAN;
    w.precipitationProbability = static_cast<uint8_t>(arrProb[nowIndex] | 0);
    if (nowIndex >= 6) {
      const float oldPressure = arrPressure[nowIndex - 6] | NAN;
      if (finite(w.pressure) && finite(oldPressure)) w.pressureDelta6h = w.pressure - oldPressure;
    }
  }

  for (size_t n = 0; n < w.hourly.size(); ++n) {
    const int i = nowIndex + static_cast<int>(n);
    if (i < 0 || i >= static_cast<int>(times.size())) break;
    HourForecast& h = w.hourly[n];
    copyHm_(h.time, times[i] | "");
    h.temperature = arrTemp[i] | NAN;
    h.apparent = arrApp[i] | NAN;
    h.humidity = arrHum[i] | NAN;
    h.dewPoint = arrDew[i] | NAN;
    h.pressure = arrPressure[i] | NAN;
    h.wind = arrWind[i] | NAN;
    h.windDirection = arrDir[i] | NAN;
    h.gust = arrGust[i] | NAN;
    h.precipitation = arrPrecip[i] | NAN;
    h.rain = arrRain[i] | NAN;
    h.precipitationProbability = static_cast<uint8_t>(arrProb[i] | 0);
    h.visibility = arrVis[i] | NAN;
    h.uv = arrUv[i] | NAN;
    h.weatherCode = arrCode[i] | -1;
    ++w.hourlyCount;
  }

  JsonObject daily = doc["daily"];
  JsonArray dates = daily["time"];
  auto dMax = daily["temperature_2m_max"].as<JsonArray>();
  auto dMin = daily["temperature_2m_min"].as<JsonArray>();
  auto dPrecip = daily["precipitation_sum"].as<JsonArray>();
  auto dProb = daily["precipitation_probability_max"].as<JsonArray>();
  auto dCode = daily["weather_code"].as<JsonArray>();
  auto dSunrise = daily["sunrise"].as<JsonArray>();
  auto dSunset = daily["sunset"].as<JsonArray>();
  auto dUv = daily["uv_index_max"].as<JsonArray>();

  for (size_t i = 0; i < w.daily.size() && i < dates.size(); ++i) {
    DayForecast& d = w.daily[i];
    copyDate_(d.date, dates[i] | "");
    d.maximum = dMax[i] | NAN;
    d.minimum = dMin[i] | NAN;
    d.precipitation = dPrecip[i] | NAN;
    d.precipitationProbability = static_cast<uint8_t>(dProb[i] | 0);
    d.weatherCode = dCode[i] | -1;
    copyHm_(d.sunrise, dSunrise[i] | "");
    copyHm_(d.sunset, dSunset[i] | "");
    d.uvMax = dUv[i] | NAN;
    ++w.dailyCount;
  }

  w.valid = finite(w.temperature);
  w.fromCache = false;
  w.fetchedAt = time(nullptr);
  if (w.fetchedAt < 1609459200) w.fetchedAt = 0;
  out = w;
  return w.valid;
}

bool OpenMeteoClient::fetchAir(AirSnapshot& out) {
  JsonDocument doc;
  if (!getJson_(airUrl_(), doc, "air")) return false;
  JsonObject c = doc["current"];
  AirSnapshot a{};
  a.pm25 = c["pm2_5"] | NAN;
  a.pm10 = c["pm10"] | NAN;
  a.co = c["carbon_monoxide"] | NAN;
  a.no2 = c["nitrogen_dioxide"] | NAN;
  a.so2 = c["sulphur_dioxide"] | NAN;
  a.ozone = c["ozone"] | NAN;
  a.europeanAqi = c["european_aqi"] | NAN;
  a.usAqi = c["us_aqi"] | NAN;
  a.dust = c["dust"] | NAN;
  a.valid = finite(a.europeanAqi) || finite(a.pm25);
  a.fromCache = false;
  a.fetchedAt = time(nullptr);
  if (a.fetchedAt < 1609459200) a.fetchedAt = 0;
  out = a;
  return a.valid;
}

}  // namespace ws

// ====================== src/StorageService.cpp ======================
namespace ws {
namespace {
constexpr uint32_t kCacheMagic = 0x32535758;  // "XWS2"
constexpr uint16_t kCacheSchema = 2;
constexpr const char* kDir = "/ws2";
constexpr const char* kCacheFile = "/ws2/cache.bin";
constexpr const char* kCacheTemp = "/ws2/cache.tmp";
constexpr const char* kCacheBackup = "/ws2/cache.bak";
constexpr const char* kHistoryFile = "/ws2/history.csv";

struct CacheHeader {
  uint32_t magic;
  uint16_t schema;
  uint16_t reserved;
  uint32_t weatherSize;
  uint32_t airSize;
  uint32_t hash;
};

struct LiteCache {
  uint32_t magic = kCacheMagic;
  uint16_t schema = kCacheSchema;
  uint16_t reserved = 0;
  WeatherSnapshot weather{};
  AirSnapshot air{};
};
}

bool StorageService::beginSd_() {
  if (board::kSdProfile == board::SdProfile::SharedLcdBusCs41) {
    SPI.begin(board::kSharedSdSclk, board::kSharedSdMiso, board::kSharedSdMosi, board::kSharedSdCs);
    return SD.begin(board::kSharedSdCs, SPI, 10000000);
  }
  return SD.begin(board::kLegacySdCs);
}

bool StorageService::begin() {
  sdAvailable_ = beginSd_();
  Serial.printf("[storage] TF card: %s\n", sdAvailable_ ? "ready" : "not mounted");
  if (sdAvailable_) ensureFiles_();
  return sdAvailable_;
}

void StorageService::ensureFiles_() {
  if (!SD.exists(kDir)) SD.mkdir(kDir);
  if (!SD.exists(kHistoryFile)) {
    File f = SD.open(kHistoryFile, FILE_WRITE);
    if (f) {
      f.println("epoch,temperature_c,apparent_c,humidity_pct,dewpoint_c,pressure_hpa,wind_kmh,gust_kmh,wind_deg,rain_mm,precip_mm,uv,aqi_eu,pm25,pm10,battery_v");
      f.close();
    }
  }
}

uint32_t StorageService::hash_(const uint8_t* data, size_t size, uint32_t seed) {
  uint32_t h = seed;
  for (size_t i = 0; i < size; ++i) {
    h ^= data[i];
    h *= 16777619u;
  }
  return h;
}

bool StorageService::loadSdCacheFile_(const char* path, WeatherSnapshot& weather, AirSnapshot& air) {
  if (!sdAvailable_ || !SD.exists(path)) return false;
  File f = SD.open(path, FILE_READ);
  if (!f) return false;
  CacheHeader h{};
  if (f.read(reinterpret_cast<uint8_t*>(&h), sizeof(h)) != sizeof(h) || h.magic != kCacheMagic || h.schema != kCacheSchema || h.weatherSize != sizeof(WeatherSnapshot) || h.airSize != sizeof(AirSnapshot)) {
    f.close();
    return false;
  }
  WeatherSnapshot w{};
  AirSnapshot a{};
  const bool full = f.read(reinterpret_cast<uint8_t*>(&w), sizeof(w)) == sizeof(w) && f.read(reinterpret_cast<uint8_t*>(&a), sizeof(a)) == sizeof(a);
  f.close();
  if (!full) return false;
  uint32_t hash = hash_(reinterpret_cast<const uint8_t*>(&w), sizeof(w));
  hash = hash_(reinterpret_cast<const uint8_t*>(&a), sizeof(a), hash);
  if (hash != h.hash) return false;
  w.fromCache = w.valid;
  a.fromCache = a.valid;
  weather = w;
  air = a;
  return weather.valid || air.valid;
}

bool StorageService::loadSdCache_(WeatherSnapshot& weather, AirSnapshot& air) {
  if (loadSdCacheFile_(kCacheFile, weather, air)) return true;
  if (loadSdCacheFile_(kCacheBackup, weather, air)) {
    Serial.println("[storage] primary cache invalid; recovered backup");
    return true;
  }
  return false;
}

bool StorageService::loadNvsCache_(WeatherSnapshot& weather, AirSnapshot& air) {
  if (!prefs_.begin("weather-cache", true)) return false;
  LiteCache c{};
  const size_t got = prefs_.getBytes("snapshot", &c, sizeof(c));
  prefs_.end();
  if (got != sizeof(c) || c.magic != kCacheMagic || c.schema != kCacheSchema) return false;
  c.weather.fromCache = c.weather.valid;
  c.air.fromCache = c.air.valid;
  weather = c.weather;
  air = c.air;
  return weather.valid || air.valid;
}

bool StorageService::loadCache(WeatherSnapshot& weather, AirSnapshot& air) {
  if (loadSdCache_(weather, air)) {
    Serial.println("[storage] restored full SD cache");
    return true;
  }
  if (loadNvsCache_(weather, air)) {
    Serial.println("[storage] restored NVS cache");
    return true;
  }
  return false;
}

void StorageService::saveSdCache_(const WeatherSnapshot& weather, const AirSnapshot& air) {
  if (!sdAvailable_) return;
  CacheHeader h{};
  h.magic = kCacheMagic;
  h.schema = kCacheSchema;
  h.weatherSize = sizeof(weather);
  h.airSize = sizeof(air);
  h.hash = hash_(reinterpret_cast<const uint8_t*>(&weather), sizeof(weather));
  h.hash = hash_(reinterpret_cast<const uint8_t*>(&air), sizeof(air), h.hash);

  File f = SD.open(kCacheTemp, FILE_WRITE);
  if (!f) return;
  const bool ok = f.write(reinterpret_cast<const uint8_t*>(&h), sizeof(h)) == sizeof(h) && f.write(reinterpret_cast<const uint8_t*>(&weather), sizeof(weather)) == sizeof(weather) && f.write(reinterpret_cast<const uint8_t*>(&air), sizeof(air)) == sizeof(air);
  f.flush();
  f.close();
  if (!ok) {
    SD.remove(kCacheTemp);
    return;
  }

  WeatherSnapshot verifyWeather{};
  AirSnapshot verifyAir{};
  if (!loadSdCacheFile_(kCacheTemp, verifyWeather, verifyAir)) {
    Serial.println("[storage] cache readback verification failed");
    SD.remove(kCacheTemp);
    return;
  }

  // Two-generation commit. Preserve the last known-good snapshot until the
  // new file has been promoted. FAT rename is not a database transaction,
  // so keeping a backup closes the dangerous remove-then-power-loss window.
  SD.remove(kCacheBackup);
  if (SD.exists(kCacheFile) && !SD.rename(kCacheFile, kCacheBackup)) {
    SD.remove(kCacheTemp);
    return;
  }
  if (!SD.rename(kCacheTemp, kCacheFile)) {
    if (SD.exists(kCacheBackup)) SD.rename(kCacheBackup, kCacheFile);
    SD.remove(kCacheTemp);
    return;
  }
  SD.remove(kCacheBackup);
}

void StorageService::saveNvsCache_(const WeatherSnapshot& weather, const AirSnapshot& air) {
  LiteCache c{};
  c.weather = weather;
  c.air = air;
  if (!prefs_.begin("weather-cache", false)) return;
  prefs_.putBytes("snapshot", &c, sizeof(c));
  prefs_.end();
}

void StorageService::appendHistory_(const AppSnapshot& s) {
  if (!sdAvailable_ || !s.weather.valid) return;
  File f = SD.open(kHistoryFile, FILE_APPEND);
  if (!f) return;
  const time_t epoch = time(nullptr);
  f.printf("%lld,%.2f,%.2f,%.1f,%.2f,%.2f,%.2f,%.2f,%.1f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%.3f\n",
           static_cast<long long>(epoch), s.weather.temperature, s.weather.apparent,
           s.weather.humidity, s.weather.dewPoint, s.weather.pressure,
           s.weather.wind, s.weather.gust, s.weather.windDirection,
           s.weather.rain, s.weather.precipitation, s.weather.uv,
           s.air.europeanAqi, s.air.pm25, s.air.pm10, s.system.batteryVoltage);
  f.close();
  ++historySamples_;
}

void StorageService::service(const AppSnapshot& s) {
  const bool weatherChanged = s.weather.valid && !s.weather.fromCache && s.weather.fetchedAt != 0 && s.weather.fetchedAt != lastWeatherCached_;
  const bool airChanged = s.air.valid && !s.air.fromCache && s.air.fetchedAt != 0 && s.air.fetchedAt != lastAirCached_;

  if (weatherChanged || airChanged) {
    saveSdCache_(s.weather, s.air);
    lastWeatherCached_ = s.weather.fetchedAt;
    lastAirCached_ = s.air.fetchedAt;

    const time_t now = time(nullptr);
    if (lastNvsCached_ == 0 || now - lastNvsCached_ >= 3600) {
      saveNvsCache_(s.weather, s.air);
      lastNvsCached_ = now;
    }
  }

  if (millis() - lastHistoryMs_ >= config::kHistoryWriteMs) {
    appendHistory_(s);
    lastHistoryMs_ = millis();
  }
}

}  // namespace ws

// ====================== src/PowerService.cpp ======================
namespace ws {

void PowerService::begin() {
  pinMode(board::kBacklight, OUTPUT);
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcAttach(board::kBacklight, board::kBacklightPwmHz, board::kBacklightPwmBits);
#else
  ledcSetup(board::kBacklightLegacyChannel, board::kBacklightPwmHz, board::kBacklightPwmBits);
  ledcAttachPin(board::kBacklight, board::kBacklightLegacyChannel);
#endif
  setBacklight_(85);
  analogReadResolution(12);
  detectBattery_();
  sampleBattery_();
}

float PowerService::readCandidate_(int pin, float divider) const {
  uint32_t sum = 0;
  constexpr int kSamples = 12;
  for (int i = 0; i < kSamples; ++i) {
    sum += analogReadMilliVolts(pin);
    delayMicroseconds(120);
  }
  return (sum / static_cast<float>(kSamples)) / 1000.0f * divider;
}

void PowerService::detectBattery_() {
  float bestScore = 999.0f;
  for (const auto& c : board::kBatteryCandidates) {
    pinMode(c.pin, INPUT);
    const float v = readCandidate_(c.pin, c.divider);
    if (v >= 3.0f && v <= 4.45f) {
      const float score = fabsf(v - 3.80f);
      if (score < bestScore) {
        bestScore = score;
        adcPin_ = c.pin;
        divider_ = c.divider;
      }
    }
  }
  if (adcPin_ >= 0) Serial.printf("[power] battery ADC GPIO%d, divider %.2fx\n", adcPin_, divider_);
  else Serial.println("[power] no plausible battery ADC detected");
}

int PowerService::socFromVoltage_(float v) {
  struct Point {
    float v;
    int pct;
  };
  static constexpr Point curve[] = {
    { 3.20f, 0 }, { 3.40f, 5 }, { 3.55f, 10 }, { 3.65f, 20 }, { 3.72f, 30 }, { 3.77f, 40 }, { 3.82f, 50 }, { 3.87f, 60 }, { 3.92f, 70 }, { 3.98f, 80 }, { 4.06f, 90 }, { 4.15f, 97 }, { 4.20f, 100 }
  };
  if (v <= curve[0].v) return 0;
  if (v >= curve[12].v) return 100;
  for (size_t i = 1; i < 13; ++i) {
    if (v <= curve[i].v) {
      const float t = (v - curve[i - 1].v) / (curve[i].v - curve[i - 1].v);
      return static_cast<int>(roundf(curve[i - 1].pct + t * (curve[i].pct - curve[i - 1].pct)));
    }
  }
  return 100;
}

void PowerService::sampleBattery_() {
  if (adcPin_ < 0) {
    voltage_ = NAN;
    percent_ = -1;
    return;
  }
  float samples[7]{};
  for (float& sample : samples) sample = readCandidate_(adcPin_, divider_);
  for (size_t i = 0; i < 7; ++i)
    for (size_t j = i + 1; j < 7; ++j)
      if (samples[j] < samples[i]) {
        const float t = samples[i];
        samples[i] = samples[j];
        samples[j] = t;
      }
  const float median = samples[3];
  voltage_ = std::isfinite(voltage_) ? voltage_ * 0.75f + median * 0.25f : median;
  percent_ = socFromVoltage_(voltage_);
}

void PowerService::setBacklight_(uint8_t percent) {
  percent = constrain(percent, 1, 100);
  const uint8_t duty = static_cast<uint8_t>(roundf(percent * 255.0f / 100.0f));
  if (duty == lastDuty_) return;
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcWrite(board::kBacklight, duty);
#else
  ledcWrite(board::kBacklightLegacyChannel, duty);
#endif
  lastDuty_ = duty;
}

void PowerService::service(const Settings& settings, const AppSnapshot& snapshot) {
  if (millis() - lastSampleMs_ >= 2000) {
    sampleBattery_();
    lastSampleMs_ = millis();
  }

  uint8_t target = settings.brightnessPct;
  if (settings.autoBrightness) {
    bool day = snapshot.weather.valid ? snapshot.weather.isDay : true;
    if (!snapshot.weather.valid) {
      struct tm t {};
      if (getLocalTime(&t, 10)) day = t.tm_hour >= 7 && t.tm_hour < 20;
    }
    target = day ? 82 : 28;
  }
  if (percent_ >= 0 && percent_ <= 15) target = std::min<uint8_t>(target, 45);
  setBacklight_(target);
}

}  // namespace ws

// ====================== src/ButtonService.cpp ======================
namespace ws {

void ButtonService::begin() {
  pinMode(board::kBootButton, INPUT_PULLUP);
  raw_ = stable_ = digitalRead(board::kBootButton);
}

ButtonService::Event ButtonService::service() {
  const bool now = digitalRead(board::kBootButton);
  if (now != raw_) {
    raw_ = now;
    rawChangedMs_ = millis();
  }

  if (raw_ != stable_ && millis() - rawChangedMs_ >= 25) {
    stable_ = raw_;
    if (stable_ == LOW) {
      pressedMs_ = millis();
      longFired_ = false;
    } else if (!longFired_) {
      if (clickPending_ && millis() - clickReleasedMs_ <= 380) {
        clickPending_ = false;
        return Event::DoubleClick;
      }
      clickPending_ = true;
      clickReleasedMs_ = millis();
    }
  }

  if (stable_ == LOW && !longFired_ && millis() - pressedMs_ >= 1200) {
    longFired_ = true;
    clickPending_ = false;
    return Event::LongPress;
  }

  if (clickPending_ && millis() - clickReleasedMs_ > 380) {
    clickPending_ = false;
    return Event::Click;
  }
  return Event::None;
}

}  // namespace ws

// ====================== src/DisplayService.cpp ======================
namespace ws {

DisplayService* DisplayService::instance_ = nullptr;

uint32_t DisplayService::tick_() {
  return millis();
}

void DisplayService::flush_(lv_display_t* display, const lv_area_t* area, uint8_t* pixels) {
  if (!instance_ || !instance_->gfx_) {
    lv_display_flush_ready(display);
    return;
  }
  const uint32_t width = area->x2 - area->x1 + 1;
  const uint32_t height = area->y2 - area->y1 + 1;
  instance_->gfx_->draw16bitRGBBitmap(area->x1, area->y1, reinterpret_cast<uint16_t*>(pixels), width, height);
  lv_display_flush_ready(display);
}

bool DisplayService::begin() {
  instance_ = this;
  bus_ = new Arduino_ESP32SPI(board::kLcdDc, board::kLcdCs, board::kLcdSclk, board::kLcdMosi, board::kLcdMiso);
  gfx_ = new Arduino_ST7789(bus_, board::kLcdRst, 0, true, board::kLcdWidth, board::kLcdHeight);
  if (!bus_ || !gfx_ || !gfx_->begin()) {
    Serial.println("[display] Arduino_GFX initialization failed");
    return false;
  }
  gfx_->fillScreen(RGB565_BLACK);

  lv_init();
  lv_tick_set_cb(tick_);
  display_ = lv_display_create(board::kLcdWidth, board::kLcdHeight);
  if (!display_) return false;

  constexpr size_t lines = 64;
  const size_t bytes = board::kLcdWidth * lines * sizeof(lv_color_t);
  buffer1_ = static_cast<uint8_t*>(heap_caps_malloc(bytes, MALLOC_CAP_DMA | MALLOC_CAP_INTERNAL));
  buffer2_ = static_cast<uint8_t*>(heap_caps_malloc(bytes, MALLOC_CAP_DMA | MALLOC_CAP_INTERNAL));
  if (!buffer1_ || !buffer2_) {
    Serial.println("[display] LVGL DMA buffer allocation failed");
    return false;
  }
  lv_display_set_buffers(display_, buffer1_, buffer2_, bytes, LV_DISPLAY_RENDER_MODE_PARTIAL);
  lv_display_set_flush_cb(display_, flush_);

  screen_ = lv_screen_active();
  lv_obj_remove_flag(screen_, LV_OBJ_FLAG_SCROLLABLE);
  Serial.println("[display] 240x320 LVGL 9 display ready");
  return true;
}

void DisplayService::service() {
  lv_timer_handler();
}

void DisplayService::setRotation180(bool enabled) {
  if (!gfx_ || enabled == rotation180_) return;
  rotation180_ = enabled;
  gfx_->setRotation(enabled ? 2 : 0);
  if (screen_) lv_obj_invalidate(screen_);
}

}  // namespace ws

// ====================== src/Format.cpp ======================
namespace ws::fmt {

String temperature(float c, const Settings& s, unsigned int decimals) {
  if (!finite(c)) return "--";
  if (s.temperatureUnit == TemperatureUnit::Fahrenheit) return String(c * 9.0f / 5.0f + 32.0f, decimals) + " F";
  return String(c, decimals) + " C";
}

String wind(float kmh, const Settings& s, unsigned int decimals) {
  if (!finite(kmh)) return "--";
  switch (s.windUnit) {
    case WindUnit::Mph: return String(kmh * 0.621371f, decimals) + " mph";
    case WindUnit::Ms: return String(kmh / 3.6f, decimals) + " m/s";
    default: return String(kmh, decimals) + " km/h";
  }
}

String pressure(float hpa, const Settings& s, unsigned int decimals) {
  if (!finite(hpa)) return "--";
  if (s.pressureUnit == PressureUnit::InHg) return String(hpa * 0.029529983f, 2) + " inHg";
  return String(hpa, decimals) + " hPa";
}

String visibility(float metres) {
  if (!finite(metres)) return "--";
  if (metres >= 1000.0f) return String(metres / 1000.0f, 1) + " km";
  return String(metres, 0) + " m";
}

String direction(float degrees) {
  if (!finite(degrees)) return "--";
  static constexpr const char* dirs[] = { "N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW" };
  int i = static_cast<int>((degrees + 11.25f) / 22.5f) % 16;
  if (i < 0) i += 16;
  return dirs[i];
}

String weatherDescription(int code) {
  switch (code) {
    case 0: return "Clear sky";
    case 1: return "Mainly clear";
    case 2: return "Partly cloudy";
    case 3: return "Overcast";
    case 45:
    case 48: return "Fog";
    case 51:
    case 53:
    case 55: return "Drizzle";
    case 56:
    case 57: return "Freezing drizzle";
    case 61:
    case 63:
    case 65: return "Rain";
    case 66:
    case 67: return "Freezing rain";
    case 71:
    case 73:
    case 75: return "Snow";
    case 77: return "Snow grains";
    case 80:
    case 81:
    case 82: return "Rain showers";
    case 85:
    case 86: return "Snow showers";
    case 95: return "Thunderstorm";
    case 96:
    case 99: return "Thunderstorm + hail";
    default: return "Unknown";
  }
}

String aqiCategory(float aqi) {
  if (!finite(aqi)) return "Unknown";
  if (aqi <= 20) return "Good";
  if (aqi <= 40) return "Fair";
  if (aqi <= 60) return "Moderate";
  if (aqi <= 80) return "Poor";
  if (aqi <= 100) return "Very poor";
  return "Extremely poor";
}

String beaufortLabel(float kmh) {
  if (!finite(kmh)) return "--";
  const float limits[] = { 1, 6, 12, 20, 29, 39, 50, 62, 75, 89, 103, 118 };
  int force = 12;
  for (int i = 0; i < 12; ++i)
    if (kmh < limits[i]) {
      force = i;
      break;
    }
  return "Bft " + String(force);
}

String pressureTrend(float delta6h) {
  if (!finite(delta6h)) return "6h trend --";
  if (delta6h > 2.0f) return "Rising +" + String(delta6h, 1) + " hPa / 6h";
  if (delta6h < -2.0f) return "Falling " + String(delta6h, 1) + " hPa / 6h";
  return "Stable " + String(delta6h, 1) + " hPa / 6h";
}

String localTime() {
  struct tm t {};
  if (!getLocalTime(&t, 10)) return "--:--";
  char b[6];
  strftime(b, sizeof(b), "%H:%M", &t);
  return b;
}

String localDate() {
  struct tm t {};
  if (!getLocalTime(&t, 10)) return "--- -- ---";
  char b[16];
  strftime(b, sizeof(b), "%a %d %b", &t);
  return b;
}

String moonPhase() {
  const time_t now = time(nullptr);
  if (now < 946684800) return "Unknown";
  constexpr double synodic = 29.530588853;
  // 2000-01-06 18:14 UTC, a well-known new moon reference.
  constexpr time_t reference = 947182440;
  double days = difftime(now, reference) / 86400.0;
  double fraction = fmod(days / synodic, 1.0);
  if (fraction < 0) fraction += 1.0;
  if (fraction < 0.0625 || fraction >= 0.9375) return "New moon";
  if (fraction < 0.1875) return "Waxing crescent";
  if (fraction < 0.3125) return "First quarter";
  if (fraction < 0.4375) return "Waxing gibbous";
  if (fraction < 0.5625) return "Full moon";
  if (fraction < 0.6875) return "Waning gibbous";
  if (fraction < 0.8125) return "Last quarter";
  return "Waning crescent";
}

const char* pageName(Page page) {
  switch (page) {
    case Page::Home: return "TODAY";
    case Page::Hourly: return "48 HOURS";
    case Page::Forecast: return "7 DAY";
    case Page::Rain: return "RAIN";
    case Page::Wind: return "WIND";
    case Page::Atmosphere: return "ATMOSPHERE";
    case Page::Air: return "AIR QUALITY";
    case Page::Sun: return "SUN + MOON";
    case Page::Alerts: return "ADVISORIES";
    case Page::History: return "HISTORY";
    case Page::System: return "SYSTEM";
    default: return "WEATHER";
  }
}

}  // namespace ws::fmt

// ====================== src/WeatherService.cpp ======================
namespace ws {

bool WeatherService::begin() {
  if (task_) return true;
  return xTaskCreatePinnedToCore(
           taskEntry_, "weather-net", 12288, this, 1, &task_, 0)
         == pdPASS;
}

void WeatherService::requestRefresh() {
  forceRefresh_ = true;
}

void WeatherService::taskEntry_(void* arg) {
  static_cast<WeatherService*>(arg)->run_();
}

void WeatherService::run_() {
  uint32_t ntpGraceStartedMs = 0;
  for (;;) {
    if (WiFi.status() != WL_CONNECTED) {
      ntpGraceStartedMs = 0;
      vTaskDelay(pdMS_TO_TICKS(500));
      continue;
    }

    if (time(nullptr) < 1609459200) {
      if (ntpGraceStartedMs == 0) ntpGraceStartedMs = millis();
      if (millis() - ntpGraceStartedMs < 4000) {
        vTaskDelay(pdMS_TO_TICKS(250));
        continue;
      }
    }

    const uint32_t now = millis();
    const bool forced = forceRefresh_;
    if (forced || lastWeatherMs_ == 0 || now - lastWeatherMs_ >= config::kWeatherRefreshMs) {
      WeatherSnapshot w{};
      Serial.println("[weather] refreshing forecast");
      if (client_.fetchWeather(w)) {
        store_.setWeather(w);
        lastWeatherMs_ = millis();
        Serial.println("[weather] forecast updated");
      }
    }

    const uint32_t afterWeather = millis();
    if (forced || lastAirMs_ == 0 || afterWeather - lastAirMs_ >= config::kAirRefreshMs) {
      AirSnapshot a{};
      Serial.println("[air] refreshing current air quality");
      if (client_.fetchAir(a)) {
        store_.setAir(a);
        lastAirMs_ = millis();
        Serial.println("[air] current air quality updated");
      }
    }

    forceRefresh_ = false;
    vTaskDelay(pdMS_TO_TICKS(500));
  }
}

}  // namespace ws

// ====================== src/Ui.cpp ======================
namespace ws {

lv_color_t Ui::bg_() const {
  return dark_ ? lv_color_hex(0x071018) : lv_color_hex(0xEDF3F8);
}
lv_color_t Ui::panel_() const {
  return dark_ ? lv_color_hex(0x101C28) : lv_color_hex(0xFFFFFF);
}
lv_color_t Ui::panel2_() const {
  return dark_ ? lv_color_hex(0x172738) : lv_color_hex(0xDDE8F1);
}
lv_color_t Ui::text_() const {
  return dark_ ? lv_color_hex(0xF5F8FC) : lv_color_hex(0x13202C);
}
lv_color_t Ui::muted_() const {
  return dark_ ? lv_color_hex(0x8DA0B2) : lv_color_hex(0x607384);
}

bool Ui::resolveDark_(const AppSnapshot& s) const {
  if (settings_.theme == ThemeMode::Dark) return true;
  if (settings_.theme == ThemeMode::Light) return false;
  if (s.weather.valid) return !s.weather.isDay;
  struct tm t {};
  return !(getLocalTime(&t, 10) && t.tm_hour >= 7 && t.tm_hour < 20);
}

lv_obj_t* Ui::label_(lv_obj_t* parent, const char* text, int x, int y, int w, int h,
                     const lv_font_t* font, lv_color_t color, lv_text_align_t align) {
  lv_obj_t* o = lv_label_create(parent);
  lv_label_set_text(o, text);
  lv_obj_set_pos(o, x, y);
  lv_obj_set_size(o, w, h);
  lv_obj_set_style_text_font(o, font, 0);
  lv_obj_set_style_text_color(o, color, 0);
  lv_obj_set_style_text_align(o, align, 0);
  lv_label_set_long_mode(o, LV_LABEL_LONG_CLIP);
  return o;
}

lv_obj_t* Ui::card_(int x, int y, int w, int h, lv_color_t accent, bool accentEnabled) {
  lv_obj_t* o = lv_obj_create(content_);
  lv_obj_set_pos(o, x, y);
  lv_obj_set_size(o, w, h);
  lv_obj_set_style_radius(o, 12, 0);
  lv_obj_set_style_bg_color(o, panel_(), 0);
  lv_obj_set_style_bg_opa(o, LV_OPA_COVER, 0);
  lv_obj_set_style_border_width(o, accentEnabled ? 1 : 0, 0);
  if (accentEnabled) lv_obj_set_style_border_color(o, accent, 0);
  lv_obj_set_style_pad_all(o, 0, 0);
  lv_obj_remove_flag(o, LV_OBJ_FLAG_SCROLLABLE);
  return o;
}

void Ui::metricCard_(size_t slot, const char* caption, int x, int y, int w, int h, lv_color_t accent) {
  lv_obj_t* c = card_(x, y, w, h);
  label_(c, caption, 9, 7, w - 18, 14, &lv_font_montserrat_16, muted_());
  value_[slot] = label_(c, "--", 9, 24, w - 18, h - 27, &lv_font_montserrat_16, accent);
}

void Ui::clearPageRefs_() {
  value_.fill(nullptr);
  chart_ = nullptr;
  chartSeries_ = nullptr;
}

void Ui::buildShell_() {
  root_ = display_.screen();
  lv_obj_clean(root_);
  lv_obj_set_style_bg_color(root_, bg_(), 0);
  lv_obj_set_style_bg_opa(root_, LV_OPA_COVER, 0);
  lv_obj_set_style_pad_all(root_, 0, 0);
  lv_obj_remove_flag(root_, LV_OBJ_FLAG_SCROLLABLE);

  header_ = lv_obj_create(root_);
  lv_obj_set_pos(header_, 0, 0);
  lv_obj_set_size(header_, 240, 48);
  lv_obj_set_style_bg_color(header_, bg_(), 0);
  lv_obj_set_style_bg_opa(header_, LV_OPA_COVER, 0);
  lv_obj_set_style_border_width(header_, 0, 0);
  lv_obj_set_style_pad_all(header_, 0, 0);
  lv_obj_remove_flag(header_, LV_OBJ_FLAG_SCROLLABLE);

  headerLocation_ = label_(header_, config::kLocationName, 9, 4, 105, 18, &lv_font_montserrat_16, muted_());
  headerTime_ = label_(header_, "--:--", 174, 3, 57, 20, &lv_font_montserrat_16, cyan_(), LV_TEXT_ALIGN_RIGHT);
  headerPage_ = label_(header_, fmt::pageName(page_), 9, 23, 135, 22, &lv_font_montserrat_16, text_());
  headerStatus_ = label_(header_, "OFF  --%", 145, 26, 86, 16, &lv_font_montserrat_16, muted_(), LV_TEXT_ALIGN_RIGHT);

  content_ = lv_obj_create(root_);
  lv_obj_set_pos(content_, 0, 48);
  lv_obj_set_size(content_, 240, 240);
  lv_obj_set_style_bg_color(content_, bg_(), 0);
  lv_obj_set_style_bg_opa(content_, LV_OPA_COVER, 0);
  lv_obj_set_style_border_width(content_, 0, 0);
  lv_obj_set_style_pad_all(content_, 0, 0);
  lv_obj_remove_flag(content_, LV_OBJ_FLAG_SCROLLABLE);

  footer_ = lv_obj_create(root_);
  lv_obj_set_pos(footer_, 0, 288);
  lv_obj_set_size(footer_, 240, 32);
  lv_obj_set_style_bg_color(footer_, bg_(), 0);
  lv_obj_set_style_bg_opa(footer_, LV_OPA_COVER, 0);
  lv_obj_set_style_border_width(footer_, 0, 0);
  lv_obj_set_style_pad_all(footer_, 0, 0);
  lv_obj_remove_flag(footer_, LV_OBJ_FLAG_SCROLLABLE);
  footerInfo_ = label_(footer_, "", 9, 7, 222, 18, &lv_font_montserrat_16, muted_(), LV_TEXT_ALIGN_CENTER);
}

void Ui::begin() {
  const AppSnapshot s = store_.snapshot();
  dark_ = resolveDark_(s);
  page_ = settings_.lastPage;
  buildShell_();
  buildPage_();
  refresh_(s, true);
  lastCarouselMs_ = millis();
}

void Ui::settingsChanged(bool rebuild) {
  const AppSnapshot s = store_.snapshot();
  const bool newDark = resolveDark_(s);
  if (rebuild || newDark != dark_) {
    dark_ = newDark;
    buildShell_();
    buildPage_();
  }
  refresh_(s, true);
}

void Ui::setPage(Page p) {
  if (static_cast<uint8_t>(p) >= static_cast<uint8_t>(Page::Count)) p = Page::Home;
  page_ = p;
  if (content_) {
    lv_obj_clean(content_);
    clearPageRefs_();
    buildPage_();
    refresh_(store_.snapshot(), true);
  }
  lastCarouselMs_ = millis();
}

void Ui::nextPage() {
  uint8_t n = static_cast<uint8_t>(page_) + 1;
  if (n >= static_cast<uint8_t>(Page::Count)) n = 0;
  setPage(static_cast<Page>(n));
}

void Ui::home() {
  setPage(Page::Home);
}

void Ui::buildPage_() {
  lv_label_set_text(headerPage_, fmt::pageName(page_));
  switch (page_) {
    case Page::Home: buildHome_(); break;
    case Page::Hourly: buildHourly_(); break;
    case Page::Forecast: buildForecast_(); break;
    case Page::Rain: buildRain_(); break;
    case Page::Wind: buildWind_(); break;
    case Page::Atmosphere: buildAtmosphere_(); break;
    case Page::Air: buildAir_(); break;
    case Page::Sun: buildSun_(); break;
    case Page::Alerts: buildAlerts_(store_.snapshot()); break;
    case Page::History: buildHistory_(); break;
    case Page::System: buildSystem_(); break;
    default: break;
  }
  const String footer = String(static_cast<uint8_t>(page_) + 1) + "/" + String(static_cast<uint8_t>(Page::Count)) + (settings_.carousel ? "   AUTO ON" : "   AUTO OFF") + "   HOLD=HOME";
  lv_label_set_text(footerInfo_, footer.c_str());
}

