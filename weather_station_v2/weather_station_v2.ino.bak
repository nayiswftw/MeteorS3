// ====================== include/BoardConfig.h ======================
namespace ws::board {

// -----------------------------------------------------------------------------
// Display: these pins match the V1 project that already worked on the user's
// Waveshare ESP32-S3-LCD-2. Keep revision-sensitive hardware here only.
// -----------------------------------------------------------------------------
inline constexpr int kLcdWidth = 240;
inline constexpr int kLcdHeight = 320;
inline constexpr int kLcdSclk = 39;
inline constexpr int kLcdMosi = 38;
inline constexpr int kLcdMiso = 40;
inline constexpr int kLcdDc = 42;
inline constexpr int kLcdCs = 45;
inline constexpr int kLcdRst = -1;
inline constexpr int kBacklight = 1;
inline constexpr int kBootButton = 0;

// QMI8658 onboard I2C. If a future PCB revision differs, change only these.
inline constexpr int kImuSda = 48;
inline constexpr int kImuScl = 47;
inline constexpr uint32_t kImuClockHz = 400000;
inline constexpr bool kImuRotationInvert = false;

// -----------------------------------------------------------------------------
// TF card profile.
// The V1 sketch used CS=21 and no explicit SPI remap. That is the default here
// because it is the user's known-good baseline. A newer board/documentation
// profile seen in the wild uses the LCD SPI lines with CS=41; switch the enum
// if that is your PCB revision.
// -----------------------------------------------------------------------------
enum class SdProfile : uint8_t {
  LegacyV1,
  SharedLcdBusCs41,
};
inline constexpr SdProfile kSdProfile = SdProfile::LegacyV1;

inline constexpr int kLegacySdCs = 21;
inline constexpr int kSharedSdSclk = 39;
inline constexpr int kSharedSdMosi = 38;
inline constexpr int kSharedSdMiso = 40;
inline constexpr int kSharedSdCs = 41;

// Battery revisions differ. V2 probes both known layouts and selects the
// plausible Li-ion reading at boot. These are input-only ADC reads.
struct BatteryCandidate {
  int pin;
  float divider;
};
inline constexpr BatteryCandidate kBatteryCandidates[] = {
  { 4, 2.0f },  // V1-proven source configuration
  { 5, 3.0f },  // newer 200K/100K divider layout
};

inline constexpr uint32_t kBacklightPwmHz = 20000;
inline constexpr uint8_t kBacklightPwmBits = 8;
inline constexpr uint8_t kBacklightLegacyChannel = 7;

}  // namespace ws::board

