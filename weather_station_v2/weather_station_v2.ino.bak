}

void Ui::buildAlerts_(const AppSnapshot& s) {
  struct Alert {
    String text;
    lv_color_t color;
  } alerts[7];
  int count = 0;
  if (s.weather.valid) {
    if (s.weather.temperature >= 40) alerts[count++] = { "Extreme heat", red_() };
    else if (s.weather.temperature >= 35) alerts[count++] = { "High temperature", orange_() };
    if (s.weather.gust >= 65 || s.weather.wind >= 50) alerts[count++] = { "High wind", red_() };
    int maxRain = 0;
    for (int i = 0; i < s.weather.hourlyCount && i < 6; ++i) maxRain = std::max(maxRain, static_cast<int>(s.weather.hourly[i].precipitationProbability));
    if (maxRain >= 70) alerts[count++] = { "High rain chance / 6h", blue_() };
    if (s.weather.uv >= 8) alerts[count++] = { "Very high UV", red_() };
    else if (s.weather.uv >= 6) alerts[count++] = { "High UV", yellow_() };
    if (s.weather.weatherCode >= 95) alerts[count++] = { "Thunderstorm signal", purple_() };
    if (s.weather.pressureDelta6h <= -4.0f) alerts[count++] = { "Rapid pressure fall", orange_() };
  }
  if (s.air.valid && s.air.europeanAqi >= 80 && count < 7) alerts[count++] = { "Poor air quality", red_() };
  if (count == 0) alerts[count++] = { "No active local advisories", green_() };

  label_(content_, "Threshold advisories - not official warnings", 9, 2, 222, 18, &lv_font_montserrat_16, muted_(), LV_TEXT_ALIGN_CENTER);
  for (int i = 0; i < count && i < 6; ++i) {
    lv_obj_t* c = card_(8, 27 + i * 34, 224, 29, alerts[i].color, true);
    label_(c, alerts[i].text.c_str(), 9, 6, 206, 18, &lv_font_montserrat_16, alerts[i].color);
  }
}

void Ui::buildHistory_() {
  metricCard_(0, "TF CARD", 8, 4, 224, 54, green_());
  metricCard_(1, "STORAGE USED", 8, 66, 108, 54, cyan_());
  metricCard_(2, "STORAGE TOTAL", 124, 66, 108, 54, blue_());
  metricCard_(3, "SESSION SAMPLES", 8, 128, 224, 54, yellow_());
  value_[4] = label_(content_, "/ws2/history.csv", 10, 194, 220, 18, &lv_font_montserrat_16, purple_(), LV_TEXT_ALIGN_CENTER);
  value_[5] = label_(content_, "15-minute durable logging", 10, 216, 220, 18, &lv_font_montserrat_16, muted_(), LV_TEXT_ALIGN_CENTER);
}

void Ui::buildSystem_() {
  for (size_t i = 0; i < 8; ++i) {
    value_[i] = label_(content_, "--", 10, 4 + static_cast<int>(i) * 27, 220, 22,
                       i == 0 ? &lv_font_montserrat_16 : &lv_font_montserrat_16,
                       i == 0 ? cyan_() : text_());
  }
  value_[8] = label_(content_, "Weather Station V2", 10, 220, 220, 18, &lv_font_montserrat_16, purple_(), LV_TEXT_ALIGN_CENTER);
}

void Ui::refreshHeader_(const AppSnapshot& s) {
  lv_label_set_text(headerTime_, fmt::localTime().c_str());
  String st = s.system.wifiConnected ? "NET" : "OFF";
  st += "  ";
  st += s.system.batteryPercent >= 0 ? String(s.system.batteryPercent) + "%" : "--%";
  lv_label_set_text(headerStatus_, st.c_str());
  lv_obj_set_style_text_color(headerStatus_, s.system.wifiConnected ? green_() : red_(), 0);
}

void Ui::refreshHome_(const AppSnapshot& s) {
  const auto& w = s.weather;
  lv_label_set_text(value_[0], fmt::temperature(w.temperature, settings_).c_str());
  String desc = fmt::weatherDescription(w.weatherCode);
  if (w.fromCache) desc += "  OFFLINE";
  lv_label_set_text(value_[1], desc.c_str());
  lv_label_set_text(value_[2], (String("Feels ") + fmt::temperature(w.apparent, settings_)).c_str());
  lv_label_set_text(value_[3], finite(w.humidity) ? (String(w.humidity, 0) + "%").c_str() : "--");
  lv_label_set_text(value_[4], finite(w.uv) ? String(w.uv, 1).c_str() : "--");
  lv_label_set_text(value_[5], (fmt::direction(w.windDirection) + " " + fmt::wind(w.wind, settings_, 0)).c_str());
  String aq = s.air.valid ? String(s.air.europeanAqi, 0) + " " + fmt::aqiCategory(s.air.europeanAqi) : "--";
  lv_label_set_text(value_[6], aq.c_str());
  lv_label_set_text(value_[7], (String("Pressure  ") + fmt::pressure(w.pressure, settings_, 0) + "   " + fmt::pressureTrend(w.pressureDelta6h)).c_str());
}

void Ui::refreshHourly_(const AppSnapshot& s) {
  const auto& w = s.weather;
  lv_label_set_text(value_[0], fmt::temperature(w.temperature, settings_, 0).c_str());
  const int rain = w.hourlyCount ? w.hourly[0].precipitationProbability : 0;
  lv_label_set_text(value_[1], (String(rain) + "%").c_str());
  float lo = 999, hi = -999;
  const int count = std::min<int>(24, w.hourlyCount);
  for (int i = 0; i < count; ++i)
    if (finite(w.hourly[i].temperature)) {
      lo = std::min(lo, w.hourly[i].temperature);
      hi = std::max(hi, w.hourly[i].temperature);
    }
  if (lo < 900) lv_label_set_text(value_[2], (fmt::temperature(lo, settings_, 0) + " / " + fmt::temperature(hi, settings_, 0)).c_str());
  else lv_label_set_text(value_[2], "--");
  lv_label_set_text(value_[3], fmt::pressureTrend(w.pressureDelta6h).c_str());

  if (chart_ && chartSeries_) {
    lv_chart_set_point_count(chart_, 24);
    if (lo >= 900) {
      lo = 0;
      hi = 40;
    }
    float plotLo = lo, plotHi = hi;
    if (settings_.temperatureUnit == TemperatureUnit::Fahrenheit) {
      plotLo = lo * 1.8f + 32;
      plotHi = hi * 1.8f + 32;
    }
    if (plotHi - plotLo < 4) {
      plotLo -= 2;
      plotHi += 2;
    }
    lv_chart_set_range(chart_, LV_CHART_AXIS_PRIMARY_Y, static_cast<int>(floorf(plotLo - 2)), static_cast<int>(ceilf(plotHi + 2)));
    for (int i = 0; i < 24; ++i) {
      int32_t v = LV_CHART_POINT_NONE;
      if (i < count && finite(w.hourly[i].temperature)) {
        float temp = w.hourly[i].temperature;
        if (settings_.temperatureUnit == TemperatureUnit::Fahrenheit) temp = temp * 1.8f + 32;
        v = static_cast<int32_t>(roundf(temp));
      }
      lv_chart_set_value_by_id(chart_, chartSeries_, i, v);
    }
    lv_chart_refresh(chart_);
  }
}

void Ui::refreshForecast_(const AppSnapshot& s) {
  for (size_t i = 0; i < 7; ++i) {
    if (!value_[i]) continue;
    if (i >= s.weather.dailyCount) {
      lv_label_set_text(value_[i], "--");
      continue;
    }
    const DayForecast& d = s.weather.daily[i];
    String row = String(i == 0 ? "TODAY " : d.date + 5) + "  " + fmt::temperature(d.minimum, settings_, 0) + "/" + fmt::temperature(d.maximum, settings_, 0) + "  " + String(d.precipitationProbability) + "%  " + fmt::weatherDescription(d.weatherCode);
    lv_label_set_text(value_[i], row.c_str());
  }
}

void Ui::refreshRain_(const AppSnapshot& s) {
  const auto& w = s.weather;
  lv_label_set_text(value_[0], finite(w.rain) ? (String(w.rain, 1) + " mm now").c_str() : "-- mm now");
  lv_label_set_text(value_[1], (String("Chance ") + String(w.precipitationProbability) + "%").c_str());
  int first = -1;
  for (int i = 0; i < w.hourlyCount; ++i)
    if (w.hourly[i].precipitationProbability >= 50) {
      first = i;
      break;
    }
  String signal = first < 0 ? "No >=50% rain signal / 48h" : (first == 0 ? "Rain signal now" : "Rain signal in ~" + String(first) + "h");
  lv_label_set_text(value_[2], signal.c_str());
  for (int i = 0; i < 8; ++i) {
    if (!value_[3 + i]) continue;
    if (i >= w.hourlyCount) {
      lv_label_set_text(value_[3 + i], "--");
      continue;
    }
    const auto& h = w.hourly[i];
    String row = String(h.time) + "      " + String(h.precipitationProbability) + "%      " + (finite(h.precipitation) ? String(h.precipitation, 1) : "--") + " mm";
    lv_label_set_text(value_[3 + i], row.c_str());
  }
}

void Ui::refreshWind_(const AppSnapshot& s) {
  const auto& w = s.weather;
  lv_label_set_text(value_[0], fmt::wind(w.wind, settings_).c_str());
  lv_label_set_text(value_[1], fmt::direction(w.windDirection).c_str());
  lv_label_set_text(value_[2], finite(w.windDirection) ? (String(w.windDirection, 0) + " degrees").c_str() : "-- degrees");
  lv_label_set_text(value_[3], fmt::wind(w.gust, settings_).c_str());
  lv_label_set_text(value_[4], fmt::beaufortLabel(w.wind).c_str());
  float peak = NAN;
  for (int i = 0; i < w.hourlyCount && i < 6; ++i)
    if (!finite(peak) || w.hourly[i].gust > peak) peak = w.hourly[i].gust;
  lv_label_set_text(value_[5], fmt::wind(peak, settings_).c_str());
}

void Ui::refreshAtmosphere_(const AppSnapshot& s) {
  const auto& w = s.weather;
  lv_label_set_text(value_[0], fmt::pressure(w.pressure, settings_).c_str());
  lv_label_set_text(value_[1], fmt::pressureTrend(w.pressureDelta6h).c_str());
  lv_label_set_text(value_[2], finite(w.humidity) ? (String(w.humidity, 0) + "%").c_str() : "--");
  lv_label_set_text(value_[3], fmt::temperature(w.dewPoint, settings_).c_str());
  lv_label_set_text(value_[4], fmt::visibility(w.visibility).c_str());
  lv_label_set_text(value_[5], finite(w.precipitation) ? (String(w.precipitation, 1) + " mm").c_str() : "--");
}

void Ui::refreshAir_(const AppSnapshot& s) {
  const auto& a = s.air;
  lv_label_set_text(value_[0], a.valid ? (String("AQI ") + String(a.europeanAqi, 0)).c_str() : "AQI --");
  lv_label_set_text(value_[1], fmt::aqiCategory(a.europeanAqi).c_str());
  auto pollutant = [](float v, const char* unit) {
    return finite(v) ? String(v, 1) + unit : String("--");
  };
  lv_label_set_text(value_[3], pollutant(a.pm25, " ug/m3").c_str());
  lv_label_set_text(value_[4], pollutant(a.pm10, " ug/m3").c_str());
  lv_label_set_text(value_[5], pollutant(a.ozone, " ug/m3").c_str());
  lv_label_set_text(value_[6], pollutant(a.no2, " ug/m3").c_str());
  lv_label_set_text(value_[7], pollutant(a.so2, " ug/m3").c_str());
  lv_label_set_text(value_[8], pollutant(a.co, " ug/m3").c_str());
}

void Ui::refreshSun_(const AppSnapshot& s) {
  const auto& w = s.weather;
  const char* rise = w.dailyCount ? w.daily[0].sunrise : "--:--";
  const char* set = w.dailyCount ? w.daily[0].sunset : "--:--";
  lv_label_set_text(value_[0], rise);
  lv_label_set_text(value_[1], set);
  lv_label_set_text(value_[2], w.valid ? (w.isDay ? "DAYLIGHT" : "NIGHT") : "--");
  lv_label_set_text(value_[3], finite(w.uv) ? String(w.uv, 1).c_str() : "--");
  lv_label_set_text(value_[4], fmt::moonPhase().c_str());
  lv_label_set_text(value_[5], fmt::localDate().c_str());
}

void Ui::refreshHistory_(const AppSnapshot& s) {
  lv_label_set_text(value_[0], s.system.sdAvailable ? "READY + LOGGING" : "NOT MOUNTED");
  lv_obj_set_style_text_color(value_[0], s.system.sdAvailable ? green_() : red_(), 0);
  const double usedMb = s.system.sdUsed / 1048576.0;
  const double totalMb = s.system.sdTotal / 1048576.0;
  lv_label_set_text(value_[1], s.system.sdAvailable ? (String(usedMb, 1) + " MB").c_str() : "--");
  lv_label_set_text(value_[2], s.system.sdAvailable ? (String(totalMb, 1) + " MB").c_str() : "--");
  lv_label_set_text(value_[3], String(s.system.historySamples).c_str());
}

void Ui::refreshSystem_(const AppSnapshot& s) {
  lv_label_set_text(value_[0], (String("WiFi  ") + (s.system.wifiConnected ? "CONNECTED  " : "OFFLINE  ") + s.system.ip).c_str());
  lv_label_set_text(value_[1], (String("RSSI  ") + (s.system.wifiConnected ? String(s.system.rssi) + " dBm" : "--")).c_str());
  lv_label_set_text(value_[2], (String("Heap  ") + String(s.system.freeHeap / 1024) + " KB").c_str());
  lv_label_set_text(value_[3], (String("PSRAM  ") + String(s.system.freePsram / 1024) + " KB").c_str());
  lv_label_set_text(value_[4], (String("Flash  ") + String(s.system.flashBytes / 1048576) + " MB").c_str());
  String bat = "Battery  ";
  bat += finite(s.system.batteryVoltage) ? String(s.system.batteryVoltage, 2) + " V  " + String(s.system.batteryPercent) + "%" : "not detected";
  lv_label_set_text(value_[5], bat.c_str());
  lv_label_set_text(value_[6], (String("TF  ") + (s.system.sdAvailable ? "READY" : "OFFLINE") + "    IMU  " + (s.system.imuAvailable ? "READY" : "OFFLINE")).c_str());
  lv_label_set_text(value_[7], (String("Data  weather ") + (s.weather.valid ? (s.weather.fromCache ? "CACHE" : "LIVE") : "NONE") + "  air " + (s.air.valid ? (s.air.fromCache ? "CACHE" : "LIVE") : "NONE")).c_str());
}

void Ui::refresh_(const AppSnapshot& s, bool dataChanged) {
  refreshHeader_(s);
  if (page_ == Page::Alerts && dataChanged) {
    lv_obj_clean(content_);
    clearPageRefs_();
    buildAlerts_(s);
  } else {
    switch (page_) {
      case Page::Home: refreshHome_(s); break;
      case Page::Hourly: refreshHourly_(s); break;
      case Page::Forecast: refreshForecast_(s); break;
      case Page::Rain: refreshRain_(s); break;
      case Page::Wind: refreshWind_(s); break;
      case Page::Atmosphere: refreshAtmosphere_(s); break;
      case Page::Air: refreshAir_(s); break;
      case Page::Sun: refreshSun_(s); break;
      case Page::History: refreshHistory_(s); break;
      case Page::System: refreshSystem_(s); break;
      default: break;
    }
  }
}

void Ui::service() {
  const AppSnapshot s = store_.snapshot();
  const bool dataChanged = s.revision != seenRevision_;
  const bool headerDue = millis() - lastHeaderMs_ >= 1000;
  const bool newDark = resolveDark_(s);

  if (newDark != dark_) {
    dark_ = newDark;
    buildShell_();
    buildPage_();
    refresh_(s, true);
    seenRevision_ = s.revision;
    lastHeaderMs_ = millis();
  } else if (dataChanged || headerDue) {
    refresh_(s, dataChanged);
    if (dataChanged) seenRevision_ = s.revision;
    if (headerDue) lastHeaderMs_ = millis();
  }

  if (settings_.carousel && millis() - lastCarouselMs_ >= static_cast<uint32_t>(settings_.carouselSeconds) * 1000UL) nextPage();
}

}  // namespace ws

// ====================== src/SerialConsole.cpp ======================
namespace ws {

void SerialConsole::begin() {
  Serial.println("[console] type 'help' for commands");
}

void SerialConsole::service() {
  while (Serial.available()) {
    const char c = static_cast<char>(Serial.read());
    if (c == '\r') continue;
    if (c == '\n') {
      line_.trim();
      if (line_.length()) execute_(line_);
      line_ = "";
    } else if (line_.length() < 120) {
      line_ += c;
    }
  }
}

void SerialConsole::help_() const {
  Serial.println("Commands:");
  Serial.println("  status | refresh | reconnect");
  Serial.println("  page 1..11 | home");
  Serial.println("  temp c|f");
  Serial.println("  wind kmh|mph|ms");
  Serial.println("  pressure hpa|inhg");
  Serial.println("  theme auto|dark|light");
  Serial.println("  brightness auto|5..100");
  Serial.println("  carousel on|off | interval 8..120");
  Serial.println("  orientation on|off");
  Serial.println("  defaults");
}

void SerialConsole::status_() const {
  const AppSnapshot s = data_.snapshot();
  Serial.printf("Firmware: Weather Station V2\n");
  Serial.printf("WiFi: %s  IP=%s  RSSI=%d\n", s.system.wifiConnected ? "connected" : "offline", s.system.ip, s.system.rssi);
  Serial.printf("Weather: %s%s  T=%.1fC  P=%.1fhPa  wind=%.1fkm/h\n",
                s.weather.valid ? "valid" : "none", s.weather.fromCache ? " (cache)" : "", s.weather.temperature, s.weather.pressure, s.weather.wind);
  Serial.printf("Air: %s%s  EU AQI=%.1f  PM2.5=%.1f\n",
                s.air.valid ? "valid" : "none", s.air.fromCache ? " (cache)" : "", s.air.europeanAqi, s.air.pm25);
  Serial.printf("Battery: %.3fV %d%% via GPIO%d | SD=%s | IMU=%s\n",
                s.system.batteryVoltage, s.system.batteryPercent, s.system.batteryAdcPin,
                s.system.sdAvailable ? "ready" : "offline", s.system.imuAvailable ? "ready" : "offline");
  Serial.printf("Heap=%uKB PSRAM=%uKB Page=%u/%u Carousel=%s\n",
                s.system.freeHeap / 1024, s.system.freePsram / 1024,
                static_cast<unsigned>(ui_.page()) + 1, static_cast<unsigned>(Page::Count), settings_.carousel ? "on" : "off");
}

void SerialConsole::saveAndRefresh_(bool rebuild) {
  settingsStore_.save(settings_);
  ui_.settingsChanged(rebuild);
}

void SerialConsole::execute_(String c) {
  c.trim();
  c.toLowerCase();
  if (c == "help" || c == "?") {
    help_();
    return;
  }
  if (c == "status") {
    status_();
    return;
  }
  if (c == "refresh") {
    weather_.requestRefresh();
    Serial.println("Refresh requested");
    return;
  }
  if (c == "reconnect") {
    network_.forceReconnect();
    return;
  }
  if (c == "home") {
    ui_.home();
    settings_.lastPage = Page::Home;
    saveAndRefresh_(false);
    return;
  }
  if (c == "defaults") {
    settingsStore_.reset();
    settings_ = Settings{};
    ui_.setPage(settings_.lastPage);
    saveAndRefresh_(true);
    Serial.println("Defaults restored");
    return;
  }

  if (c.startsWith("page ")) {
    const int n = c.substring(5).toInt();
    if (n >= 1 && n <= static_cast<int>(Page::Count)) {
      ui_.setPage(static_cast<Page>(n - 1));
      settings_.lastPage = ui_.page();
      settingsStore_.save(settings_);
    } else Serial.println("page must be 1..11");
    return;
  }
  if (c == "temp c") {
    settings_.temperatureUnit = TemperatureUnit::Celsius;
    saveAndRefresh_(false);
    return;
  }
  if (c == "temp f") {
    settings_.temperatureUnit = TemperatureUnit::Fahrenheit;
    saveAndRefresh_(false);
    return;
  }
  if (c == "wind kmh") {
    settings_.windUnit = WindUnit::Kmh;
    saveAndRefresh_(false);
    return;
  }
  if (c == "wind mph") {
    settings_.windUnit = WindUnit::Mph;
    saveAndRefresh_(false);
    return;
  }
  if (c == "wind ms") {
    settings_.windUnit = WindUnit::Ms;
    saveAndRefresh_(false);
    return;
  }
  if (c == "pressure hpa") {
    settings_.pressureUnit = PressureUnit::Hpa;
    saveAndRefresh_(false);
    return;
  }
  if (c == "pressure inhg") {
    settings_.pressureUnit = PressureUnit::InHg;
    saveAndRefresh_(false);
    return;
  }
  if (c == "theme auto") {
    settings_.theme = ThemeMode::Auto;
    saveAndRefresh_(true);
    return;
  }
  if (c == "theme dark") {
    settings_.theme = ThemeMode::Dark;
    saveAndRefresh_(true);
    return;
  }
  if (c == "theme light") {
    settings_.theme = ThemeMode::Light;
    saveAndRefresh_(true);
    return;
  }
  if (c == "brightness auto") {
    settings_.autoBrightness = true;
    saveAndRefresh_(false);
    return;
  }
  if (c.startsWith("brightness ")) {
    const int n = c.substring(11).toInt();
    if (n >= 5 && n <= 100) {
      settings_.autoBrightness = false;
      settings_.brightnessPct = n;
      saveAndRefresh_(false);
    } else Serial.println("brightness must be auto or 5..100");
    return;
  }
  if (c == "carousel on") {
    settings_.carousel = true;
    saveAndRefresh_(false);
    return;
  }
  if (c == "carousel off") {
    settings_.carousel = false;
    saveAndRefresh_(false);
    return;
  }
  if (c.startsWith("interval ")) {
    const int n = c.substring(9).toInt();
    if (n >= 8 && n <= 120) {
      settings_.carouselSeconds = n;
      saveAndRefresh_(false);
    } else Serial.println("interval must be 8..120 seconds");
    return;
  }
  if (c == "orientation on") {
    settings_.autoOrientation = true;
    saveAndRefresh_(false);
    return;
  }
  if (c == "orientation off") {
    settings_.autoOrientation = false;
    saveAndRefresh_(false);
    return;
  }

  Serial.println("Unknown command. Type 'help'.");
}

}  // namespace ws

// ====================== src/main.cpp ======================
using namespace ws;

namespace {
DataStore dataStore;
SettingsStore settingsStore;
Settings settings{};
NetworkService network;
StorageService storage;
PowerService power;
ButtonService button;
DisplayService display;
WeatherService weather(dataStore);
Ui ui(dataStore, display, settings);
SerialConsole console(settings, settingsStore, dataStore, network, weather, ui);

uint32_t lastSystemSampleMs = 0;
uint32_t settingsSaveDueMs = 0;
bool settingsDirty = false;

void markSettingsDirty() {
  settingsDirty = true;
  settingsSaveDueMs = millis() + 4000;
}

void sampleSystem() {
 static AppSnapshot current;
  static SystemSnapshot sys;

  current = dataStore.snapshot();
  sys = current.system;
  sys.wifiConnected = WiFi.status() == WL_CONNECTED;
  sys.rssi = sys.wifiConnected ? WiFi.RSSI() : 0;
  const String ip = sys.wifiConnected ? WiFi.localIP().toString() : String("0.0.0.0");
  strlcpy(sys.ip, ip.c_str(), sizeof(sys.ip));
  sys.sdAvailable = storage.available();
  sys.sdUsed = storage.usedBytes();
  sys.sdTotal = storage.totalBytes();
  sys.imuAvailable = false;
  sys.batteryVoltage = power.voltage();
  sys.batteryPercent = power.percent();
  sys.batteryAdcPin = power.adcPin();
  sys.freeHeap = ESP.getFreeHeap();
  sys.freePsram = ESP.getFreePsram();
  sys.flashBytes = ESP.getFlashChipSize();
  sys.historySamples = storage.historySamples();
  dataStore.setSystem(sys);
}

void handleButtonEvent(ButtonService::Event event) {
  switch (event) {
    case ButtonService::Event::Click:
      ui.nextPage();
      settings.lastPage = ui.page();
      markSettingsDirty();
      break;
    case ButtonService::Event::DoubleClick:
      settings.carousel = !settings.carousel;
      ui.settingsChanged(false);
      markSettingsDirty();
      Serial.printf("[input] carousel %s\n", settings.carousel ? "on" : "off");
      break;
    case ButtonService::Event::LongPress:
      ui.home();
      settings.lastPage = Page::Home;
      markSettingsDirty();
      break;
    default:
      break;
  }
}
}

void setup() {
  Serial.begin(115200);
  delay(150);
  Serial.println();
  Serial.println("================================================");
  Serial.printf("  %s %s\n", config::kFirmwareName, config::kFirmwareVersion);
  Serial.println("  Waveshare ESP32-S3-LCD-2");
  Serial.println("================================================");

  settings = settingsStore.load();
  button.begin();
  power.begin();
  storage.begin();

  if (!display.begin()) {
    Serial.println("FATAL: display initialization failed");
    while (true) delay(1000);
  }

  static WeatherSnapshot cachedWeather{};
  static AirSnapshot cachedAir{};
  if (storage.loadCache(cachedWeather, cachedAir)) {
    if (cachedWeather.valid) dataStore.setWeather(cachedWeather);
    if (cachedAir.valid) dataStore.setAir(cachedAir);
  }

  network.begin();
  if (!weather.begin()) Serial.println("[weather] weather task creation failed");

  sampleSystem();
  ui.begin();
  console.begin();

  Serial.println("[boot] ready; UI never waits for network");
}

void loop() {
  network.service();
  handleButtonEvent(button.service());

  static AppSnapshot snapshot;
  snapshot = dataStore.snapshot();
  power.service(settings, snapshot);
  storage.service(snapshot);

  if (millis() - lastSystemSampleMs >= config::kSystemSampleMs) {
    sampleSystem();
    lastSystemSampleMs = millis();
  }

  if (settingsDirty && static_cast<int32_t>(millis() - settingsSaveDueMs) >= 0) {
    settingsStore.save(settings);
    settingsDirty = false;
  }

  console.service();
  ui.service();
  display.service();
  delay(4);
}
