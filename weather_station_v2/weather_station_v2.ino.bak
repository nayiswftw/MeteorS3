  lv_obj_t* hero = card_(8, 4, 224, 91);
  value_[0] = label_(hero, "--", 12, 8, 135, 39, &lv_font_montserrat_32, text_());
  value_[1] = label_(hero, "Waiting for weather", 12, 49, 196, 18, &lv_font_montserrat_16, cyan_());
  value_[2] = label_(hero, "Feels --", 12, 69, 196, 16, &lv_font_montserrat_16, muted_());
  metricCard_(3, "HUMIDITY", 8, 103, 108, 57, cyan_());
  metricCard_(4, "UV INDEX", 124, 103, 108, 57, yellow_());
  metricCard_(5, "WIND", 8, 168, 108, 57, green_());
  metricCard_(6, "AIR QUALITY", 124, 168, 108, 57, purple_());
  value_[7] = label_(content_, "Pressure --", 12, 226, 216, 14, &lv_font_montserrat_16, muted_(), LV_TEXT_ALIGN_CENTER);
}

