// ====================== include/AppTypes.h ======================
namespace ws {

enum class TemperatureUnit : uint8_t { Celsius,
                                       Fahrenheit };
enum class WindUnit : uint8_t { Kmh,
                                Mph,
                                Ms };
enum class PressureUnit : uint8_t { Hpa,
                                    InHg };
enum class ThemeMode : uint8_t { Auto,
                                 Dark,
                                 Light };
enum class Page : uint8_t {
  Home,
  Hourly,
  Forecast,
  Rain,
  Wind,
  Atmosphere,
  Air,
  Sun,
  Alerts,
  History,
  System,
  Count
};

struct Settings {
  uint16_t schema = 2;
  TemperatureUnit temperatureUnit = TemperatureUnit::Celsius;
  WindUnit windUnit = WindUnit::Kmh;
  PressureUnit pressureUnit = PressureUnit::Hpa;
  ThemeMode theme = ThemeMode::Auto;
  bool autoBrightness = true;
  uint8_t brightnessPct = 82;
  bool carousel = true;
  uint16_t carouselSeconds = 20;
  bool autoOrientation = true;
  Page lastPage = Page::Home;
};

struct HourForecast {
  char time[6] = "--:--";
  float temperature = NAN;
  float apparent = NAN;
  float humidity = NAN;
  float dewPoint = NAN;
  float pressure = NAN;
  float wind = NAN;
  float gust = NAN;
  float windDirection = NAN;
  float precipitation = NAN;
  float rain = NAN;
  float visibility = NAN;
  float uv = NAN;
  uint8_t precipitationProbability = 0;
  int16_t weatherCode = -1;
};

struct DayForecast {
  char date[11] = "----------";
  float minimum = NAN;
  float maximum = NAN;
  float precipitation = NAN;
  float uvMax = NAN;
  uint8_t precipitationProbability = 0;
  int16_t weatherCode = -1;
  char sunrise[6] = "--:--";
  char sunset[6] = "--:--";
};

struct WeatherSnapshot {
  bool valid = false;
  bool fromCache = false;
  time_t fetchedAt = 0;
  char observationTime[17] = "----------------";

  float temperature = NAN;
  float apparent = NAN;
  float humidity = NAN;
  float dewPoint = NAN;
  float pressure = NAN;
  float pressureDelta6h = NAN;
  float wind = NAN;
  float gust = NAN;
  float windDirection = NAN;
  float precipitation = NAN;
  float rain = NAN;
  float visibility = NAN;
  float uv = NAN;
  uint8_t precipitationProbability = 0;
  int16_t weatherCode = -1;
  bool isDay = true;

  std::array<HourForecast, config::kHourlyForecastCount> hourly{};
  uint8_t hourlyCount = 0;
  std::array<DayForecast, config::kDailyForecastCount> daily{};
  uint8_t dailyCount = 0;
};

struct AirSnapshot {
  bool valid = false;
  bool fromCache = false;
  time_t fetchedAt = 0;
  float pm25 = NAN;
  float pm10 = NAN;
  float ozone = NAN;
  float no2 = NAN;
  float so2 = NAN;
  float co = NAN;
  float europeanAqi = NAN;
  float usAqi = NAN;
  float dust = NAN;
};

struct SystemSnapshot {
  bool wifiConnected = false;
  int16_t rssi = 0;
  char ip[16] = "0.0.0.0";
  bool sdAvailable = false;
  uint64_t sdUsed = 0;
  uint64_t sdTotal = 0;
  bool imuAvailable = false;
  float batteryVoltage = NAN;
  int8_t batteryPercent = -1;
  int8_t batteryAdcPin = -1;
  uint32_t freeHeap = 0;
  uint32_t freePsram = 0;
  uint32_t flashBytes = 0;
  uint32_t historySamples = 0;
};

struct AppSnapshot {
  WeatherSnapshot weather;
  AirSnapshot air;
  SystemSnapshot system;
  uint32_t revision = 0;
};

inline bool finite(float value) {
  return std::isfinite(value);
}

}  // namespace ws

