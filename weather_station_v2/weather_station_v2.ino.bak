/*
  ================================================================
    WEATHER STATION V2 — ARDUINO IDE EDITION
    Waveshare ESP32-S3-LCD-2 / ESP32-S3R8 / 240x320 ST7789
  ================================================================

  Single-file Arduino sketch. No PlatformIO. No local header files.

  REQUIRED LIBRARIES (Arduino Library Manager):
    - ArduinoJson 7.x
    - Arduino_GFX_Library
    - lvgl 9.x

  ESP32 board package supplies WiFi, HTTPClient, Preferences, SD, etc.

  IMPORTANT:
    The display/button/SD/battery defaults below are carried forward
    from the V1 sketch. Verify revision-sensitive pins before flashing.
  ================================================================
*/

#include <Arduino.h>

SET_LOOP_TASK_STACK_SIZE(24 * 1024);

