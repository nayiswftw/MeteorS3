  lv_obj_set_size(chart_, 208, 104);
  lv_obj_set_style_bg_opa(chart_, LV_OPA_TRANSP, 0);
  lv_obj_set_style_border_width(chart_, 0, 0);
  lv_obj_set_style_line_color(chart_, panel2_(), LV_PART_MAIN);
  lv_chart_set_type(chart_, LV_CHART_TYPE_LINE);
  lv_chart_set_point_count(chart_, 24);
  lv_chart_set_div_line_count(chart_, 4, 4);
